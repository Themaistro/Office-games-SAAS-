# Local Docker Compose database defaults. Replace for your own PostgreSQL instance.
# Copy this file to .env.local. Never commit real credentials.
DATABASE_URL=postgresql://brain_arena:change-me-local-only@127.0.0.1:5433/daily_brain_arena

# Development identity installed by the local bootstrap/migrations.
# For another company, provision a unique matching database/server/browser identity.
OFFICE_GAMES_COMPANY_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_OFFICE_GAMES_COMPANY_ID=00000000-0000-4000-8000-000000000001
DATABASE_POOL_MAX=10
# Runtime mode auto-detects Neon -pooler hosts. Other transaction proxies can set:
# DATABASE_CONNECTION_MODE=transaction
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000

# New registrations only. Existing account passwords are not changed.
REGISTRATION_MODE=invite
REGISTRATION_PASSWORD_MIN_LENGTH=12
ADMIN_SESSION_MAX_AGE_HOURS=8

# Keep runtime DATABASE_URL on a dedicated restricted role.
# Store MIGRATION_DATABASE_URL separately in .env.migrations.local for local tooling.

# Optional SERVER-ONLY realtime publisher key. Browsers receive scoped tokens.
ABLY_API_KEY=

# Before deployment, set these to the actual hosting/database limits and run preflight:
# EXPECTED_MAX_INSTANCES=...
# DATABASE_CONNECTION_BUDGET=...
